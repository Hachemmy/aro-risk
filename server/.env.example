# ── ARO — configuration backend ──────────────────────────────────────────────
# Copier en .env puis adapter. AUCUNE de ces variables ne contient de donnée personnelle.
# (Le prototype fonctionne SANS ce fichier : valeurs par défaut de démonstration.)

# Port d'écoute de l'API
PORT=4000

# Comptes service console administrateur (identifiant + mot de passe, non nominatifs)
ARO_ADMIN_USER=aro.admin
ARO_ADMIN_PASSWORD=AroDemo2026!

# Origines du frontend autorisées (CSP / CORS), séparées par des virgules
ARO_ALLOWED_ORIGINS=http://localhost:5173

# Journée de rétention des signalements ( purge automatique conseillée : 30 )
ARO_RETENTION_DAYS=30
